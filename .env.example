# 复制本文件为 .env，填入你自己的 Key。.env 已被 .gitignore 排除，不会上传到 GitHub。
# 不要把 Key 发到任何聊天窗口里。

DEEPSEEK_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# 可选：覆盖默认接口地址（一般不用填）
# 千问如果用百炼控制台里显示的业务空间专属地址，填在这里，末尾带 /compatible-mode/v1
# DASHSCOPE_BASE_URL=
# DEEPSEEK_BASE_URL=
# ARK_BASE_URL=
# MOONSHOT_BASE_URL=
